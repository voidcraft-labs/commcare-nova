node_modules
.next
.git
.gitignore
*.md
.env*
.playwright-mcp
# The scripts directory holds inspect / dev / one-off tooling the image
# doesn't need — exclude it to keep the build context small. The exceptions
# are the deployment/maintenance entrypoints the builder runs through esbuild
# sources; those sources must reach the build context to become self-contained
# `.cjs` files. Keep these negations in
# lockstep with every Dockerfile esbuild entrypoint. The database bootstrap
# helper is also imported by the checked-in privilege-convergence integration
# test, which production type-checking sees even though the bootstrap CLI
# itself is not image runtime code.
scripts
!scripts/
scripts/*
!scripts/migrate.ts
!scripts/cleanup-form-attachments.ts
!scripts/audit-canonical-identity-foundation.ts
!scripts/infra/
scripts/infra/*
!scripts/infra/apply-media-bucket-policy.ts
!scripts/migrate-case-type-schema-retirement.ts
!scripts/migrate-case-parent-relationships.ts
!scripts/migrate-schema-drift.ts
!scripts/migrate-legacy-preplan-builds.ts
!scripts/infra/databaseOwnerBootstrap.ts
!scripts/lib/
scripts/lib/*
!scripts/lib/caseTypeSchemaRetirement.ts
!scripts/lib/caseParentRelationshipRepair.ts
!scripts/lib/caseStatusFilterRepair.ts
!scripts/lib/xpathCarrierCompatibilityRepair.ts
!scripts/lib/loadPersistedBlueprint.ts
!scripts/lib/main.ts
!scripts/lib/schemaDrift.ts
!scripts/lib/schemaDriftMigration.ts
