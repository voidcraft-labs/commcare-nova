{
	"documentation": {
		"android-supported-formats": {
			"reading": "The decoder columns at Android 6.0 (API level 23), CommCare's minimum (commcare-android/app/build.gradle, minSdkVersion 23), since CommCare plays media with Android's own MediaPlayer and VideoView (commcare-android/app/src/org/commcare/views/media/).",
			"title": "Supported media formats (Android Developers)",
			"url": "https://developer.android.com/media/platform/supported-formats"
		},
		"apple-safari-html5-audio-video": {
			"reading": "Archived; MDN's current compatibility data takes precedence over it.",
			"title": "Using HTML5 Audio and Video (Apple Developer Documentation Archive)",
			"url": "https://developer.apple.com/library/archive/documentation/AudioVideo/Conceptual/Using_HTML5_Audio_Video/Introduction/Introduction.html"
		},
		"chromium-audio-video": {
			"reading": "The codecs and containers Chrome plays.",
			"title": "Audio/Video (The Chromium Projects)",
			"url": "https://www.chromium.org/audio-video/"
		},
		"mdn-audio-codecs": {
			"reading": "Browser support for each audio codec.",
			"title": "Web audio codec guide (MDN)",
			"url": "https://developer.mozilla.org/en-US/docs/Web/Media/Guides/Formats/Audio_codecs"
		},
		"mdn-containers": {
			"reading": "Browser support for each media container.",
			"title": "Media container formats (MDN)",
			"url": "https://developer.mozilla.org/en-US/docs/Web/Media/Guides/Formats/Containers"
		},
		"mdn-image-types": {
			"reading": "Browser support for each image file type.",
			"title": "Image file type and format guide (MDN)",
			"url": "https://developer.mozilla.org/en-US/docs/Web/Media/Guides/Formats/Image_types"
		},
		"mdn-video-codecs": {
			"reading": "Browser support for each video codec.",
			"title": "Web video codec guide (MDN)",
			"url": "https://developer.mozilla.org/en-US/docs/Web/Media/Guides/Formats/Video_codecs"
		}
	},
	"hqClassification": {
		"method": "Executed: HQ booted in the proof image, and get_class_by_data called on a file of each format under its usual extension.",
		"mimeTable": "libmagic 5.44, the compiled magic database of Debian bookworm's libmagic1, which commcare-hq/Dockerfile installs at the pin, read through python-magic 0.4.27 (commcare-hq/uv.lock); Python's mimetypes is consulted only for an application/* result, which no format here gives.",
		"reader": "commcare-hq/corehq/apps/hqmedia/models.py::CommCareMultimedia.get_class_by_data",
		"rule": "The base MIME type image, audio or video gives CommCareImage, CommCareAudio or CommCareVideo; any other gives no class, and the multimedia upload skips the file (commcare-hq/corehq/apps/hqmedia/tasks.py::process_bulk_upload_zip)."
	},
