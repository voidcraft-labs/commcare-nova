// CommCare XPath grammar for Lezer
// Supports XPath 1.0 + CommCare hashtag references (#form/, #case/, #user/)

@top XPath { expr }

@precedence {
  hashtag @left
  invoke @left
  filter @left
  path @left
  union @left
  unary @right
  multiplicative @left
  additive @left
  relational @left
  equality @left
  and @left
  or @left
}

// --- Path expressions ---

rootStep {
  Child { "/" !path step }
  | Descendant { "//" !path step }
}

step {
  AxisSpecified { AxisName { localName } "::" generalStep }
  | AttrSpecified { "@" generalStep }
  | generalStep
  | SelfStep { "." }
  | ParentStep { ".." }
}

generalStep {
  NameTest
  | Invoke {
      FunctionName { name }
      !invoke
      ArgumentList {
        "(" (expr ("," expr)*)? ")"
      }
    }
}

// --- Expressions ---

expr {
  HashtagRef
  | VariableReference
  | "(" expr ")"
  | StringLiteral
  | NumberLiteral
  | rootStep
  | RootPath { "/" } ~-10
  | step
  | Child { expr !path "/" step }
  | Descendant { expr !path "//" step }
  | Filtered { expr !filter "[" expr "]" }
  | UnionExpr { expr !union "|" expr }
  | UnaryNegativeExpr { "-" !unary expr }
  | MultiplyExpr { expr !multiplicative "*" expr }
  | DivideExpr { expr !multiplicative DivOp expr }
  | ModulusExpr { expr !multiplicative ModOp expr }
  | AddExpr { expr !additive "+" expr }
  | SubtractExpr { expr !additive "-" expr }
  | GreaterThanExpr { expr !relational ">" expr }
  | GreaterEqualExpr { expr !relational ">=" expr }
  | LessThanExpr { expr !relational "<" expr }
  | LessEqualExpr { expr !relational "<=" expr }
  | NotEqualsExpr { expr !equality "!=" expr }
  | EqualsExpr { expr !equality "=" expr }
  | AndExpr { expr !and AndOp expr }
  | OrExpr { expr !or OrOp expr }
}

// CommCare hashtag references: #form/field, #case/property, #user/property
// Structured as type + path segments so consumers get named child nodes.
// !hashtag on "/" ensures the parser continues consuming path segments
// rather than reducing early and treating "/" as a child-step operator.
// A hashtag is one CONTIGUOUS span ("# form/x" / "#form/ x" / "#form /x"
// are not refs), matching the regex matchers built from
// lib/domain/hashtagSegments.ts (divergence-corpus test enforced). The
// grammar skips whitespace between any two tokens and an open-ended
// skipless rule is inexpressible in LR ("inconsistent skip sets"), so
// contiguity rides on zero-width guard tokens: the external tokenizer
// emits one only when nothing was skipped before the current token AND
// the lookahead can genuinely continue the ref (so the guard never wins
// a shift the following token would then fail).
//
// Segments are the dedicated ASCII `hashtagName` token — NOT `localName`
// — so a segment's full EXTENT agrees with the regex matchers'
// `[A-Za-z0-9_-]+` charset. XPath element names (`NameTest`)
// use the worker's UTF-16 name grammar; hashtag segments never had a Unicode
// vocabulary (field ids and case properties are ASCII by the identifier
// rules), and a wider token here made this matcher claim a longer ref
// than the regex layers could find.
@external tokens hashtagGuard from "./hashtagGuard" { noGapIdent, noGapSlash }
@external tokens coreOperatorTokens from "./coreOperatorTokens" { AndOp, OrOp, DivOp, ModOp }
@external tokens coreNameTokens from "./coreNameTokens" { localName, qualifiedName, qualifiedWildcard, VariableReference }

HashtagRef { "#" noGapIdent HashtagType { hashtagName } (!hashtag noGapSlash "/" noGapIdent HashtagSegment { hashtagName })+ }

NameTest {
  name
  | Wildcard { "*" }
  | QualifiedWildcard { qualifiedWildcard }
}

name {
  localName
  | qualifiedName
}

// --- Tokens ---

@skip {
  whitespace
}

@tokens {
  whitespace { $[ \r\n\t\f]+ }

  // One hashtag segment (namespace or path segment): the ASCII charset
  // shared with `HASHTAG_SEGMENT_SOURCE`, `[A-Za-z0-9_-]+`
  // (lib/domain/hashtagSegments.ts). Deliberately narrower than `localName`:
  // the editor matcher and parser must agree on a segment's extent.
  hashtagName { (@asciiLetter | "_" | @digit | "-")+ }

  StringLiteral {
    "\"" !["]* "\""
    | "'" ![']* "'"
  }

  NumberLiteral {
    @digit+ ("." @digit*)?
    | "." @digit+
  }

  "#"
  "//"
  "/"
  ".."
  "."
  "::"
  "@"
  "!="
  ">="
  "<="
  ">"
  "<"
  "="
  "+"
  "-"
  "|"
  "*"
  "["
  "]"
  "("
  ")"
  ","

  @precedence {
    "//", "/",
    "..", NumberLiteral, ".",
    "#"
  }
}

@detectDelim
