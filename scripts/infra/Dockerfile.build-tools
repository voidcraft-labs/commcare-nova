# Independent operator-built tool image. Rebuild explicitly when updating pins;
# application releases consume its immutable digest and never build it.
FROM docker:24.0.9-cli@sha256:dba081061b860672b2f50172ee0449b4d0a673586056ee8c12bf7747469e3cbe AS docker-cli
FROM node:24.18.1-alpine@sha256:9b6d6e32fdbed527c0492b8e2d9d4c9081644a080b772670816bec13ba50b683 AS node-cli
FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:565.0.0-alpine@sha256:a8918eb9dce594806a1e67b6da0f94d878e2aacea20e89eddaaed29e7ada061f
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=node-cli /usr/local/bin/node /usr/local/bin/node
ADD --checksum=sha256:48af8a397ebd60178778bf63611dbcebe5f5e7a9be90eb9147b24b9587455778 https://github.com/docker/buildx/releases/download/v0.36.1/buildx-v0.36.1.linux-amd64 /usr/local/libexec/docker/cli-plugins/docker-buildx
RUN chmod 755 /usr/local/libexec/docker/cli-plugins/docker-buildx && \
    docker --version && docker buildx version && node --version && \
    python3 --version && bash --version && curl --version && gcloud --version
ENTRYPOINT []
