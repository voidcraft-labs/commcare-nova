		"b057dedb872640c1b9b921ccbe3cba60.xml": "<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n<h:html xmlns:h=\"http://www.w3.org/1999/xhtml\" xmlns:orx=\"http://openrosa.org/jr/xforms\" xmlns=\"http://www.w3.org/2002/xforms\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:jr=\"http://openrosa.org/javarosa\" xmlns:vellum=\"http://commcarehq.org/xforms/vellum\">\n\t<h:head>\n\t\t<h:title>Survey</h:title>\n\t\t<model>\n\t\t\t<instance>\n\t\t\t\t<data xmlns:jrm=\"http://dev.commcarehq.org/jr/xforms\" xmlns=\"http://openrosa.org/formdesigner/bd5abd98-7cf9-41dc-8c22-ed47ae52e31d\" uiVersion=\"1\" version=\"3\" name=\"Survey\">\n\t\t\t\t\t<farmer_name />\n\t\t\t\t\t<district />\n\t\t\t\t\t<village />\n\t\t\t\t\t<crop />\n\t\t\t\t</data>\n\t\t\t</instance>\n\t\t\t<instance id=\"item-list:seasons\" src=\"jr://fixture/item-list:seasons\" />\n\t\t\t<instance src=\"jr://fixture/item-list:districts\" id=\"item-list:districts\" />\n\t\t\t<instance src=\"jr://fixture/item-list:villages\" id=\"item-list:villages\" />\n\t\t\t<instance src=\"jr://fixture/item-list:crop-types\" id=\"item-list:crop-types\" />\n\t\t\t<bind vellum:nodeset=\"#form/farmer_name\" nodeset=\"/data/farmer_name\" type=\"xsd:string\" />\n\t\t\t<bind vellum:nodeset=\"#form/district\" nodeset=\"/data/district\" />\n\t\t\t<bind vellum:nodeset=\"#form/village\" nodeset=\"/data/village\" />\n\t\t\t<bind vellum:nodeset=\"#form/crop\" nodeset=\"/data/crop\" />\n\t\t\t<itext>\n\t\t\t\t<translation lang=\"en\" default=\"\">\n\t\t\t\t\t<text id=\"farmer_name-label\">\n\t\t\t\t\t\t<value>Farmer's name</value>\n\t\t\t\t\t</text>\n\t\t\t\t\t<text id=\"district-label\">\n\t\t\t\t\t\t<value>District</value>\n\t\t\t\t\t</text>\n\t\t\t\t\t<text id=\"village-label\">\n\t\t\t\t\t\t<value>Village</value>\n\t\t\t\t\t</text>\n\t\t\t\t\t<text id=\"crop-label\">\n\t\t\t\t\t\t<value>Main crop</value>\n\t\t\t\t\t</text>\n\t\t\t\t</translation>\n\t\t\t</itext>\n\t\t</model>\n\t</h:head>\n\t<h:body>\n\t\t<input vellum:ref=\"#form/farmer_n