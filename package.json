{
	"name": "commcare-nova",
	"version": "0.6.0",
	"private": true,
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.18.1",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": "12.0.2",
			"onFail": "error"
		}
	},
	"allowScripts": {
		"@sentry/cli": false,
		"cpu-features": false,
		"esbuild": false,
		"fsevents": false,
		"lefthook": false,
		"protobufjs": false,
		"sharp": false,
		"ssh2": false
	},
	"scripts": {
		"postinstall": "node scripts/harden-agent-react-devtools.mjs && fumadocs-mdx",
		"predev": "node scripts/check-node.mjs && npm run build:xpath-worker",
		"dev": "npm run db:dev && NEXT_TELEMETRY_DISABLED=1 next dev",
		"db:dev": "docker compose up -d --wait && NOVA_DB_LOCAL_URL=postgres://nova:nova@localhost:5432/nova_cases?sslmode=disable npm run db:migrate",
		"db:migrate": "NOVA_DB_WORKLOAD=migration tsx --conditions=react-server scripts/migrate.ts",
		"db:dev:down": "docker compose down",
		"verify:java-pattern-runtime": "node scripts/java-pattern-runtime/verify.mjs",
		"build:xpath-worker": "node scripts/build-xpath-worker.mjs",
		"prebuild": "npm run verify:java-pattern-runtime && npm run build:xpath-worker",
		"build": "NEXT_TELEMETRY_DISABLED=1 next build && tsc --noEmit",
		"start": "node scripts/start-standalone.mjs",
		"lint": "biome check --error-on-warnings",
		"format": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:changed": "vitest run --changed origin/main",
		"test:leaks": "vitest run --detect-async-leaks --pool=forks --testTimeout=30000",
		"test:schema": "tsx --conditions=react-server scripts/test-schema.ts",
		"eval:translations": "tsx --conditions=react-server scripts/evaluate-translations.ts",
		"audit:hq-feature-flags": "node scripts/audit-commcare-hq-feature-flags.mjs",
		"test:smoke": "bash scripts/smoke.sh",
		"test:smoke:headed": "bash scripts/smoke.sh --headed",
		"test:smoke:url": "playwright test --project=public",
		"profile:react": "bash scripts/react-profile.sh",
		"case:manual": "PORT=3100 SMOKE_BASE_URL=http://localhost:3100 BETTER_AUTH_URL=http://localhost:3100 CASE_WORKSPACE_MANUAL=1 bash scripts/smoke.sh --project=case-workspace-manual --headed",
		"mp:watch": "MP_TILE=1 MP_SLOWMO=${MP_SLOWMO:-3000} bash scripts/smoke.sh --project=multiplayer --headed",
		"mp:manual": "MP_MANUAL=1 bash scripts/smoke.sh --project=mp-manual --headed"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.47",
		"@ai-sdk/react": "4.0.82",
		"@ai-sdk/workflow": "1.0.70",
		"@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
		"@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.1.0",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.1.0",
		"@better-auth/api-key": "1.7.1",
		"@better-auth/mcp": "1.7.1",
		"@better-auth/oauth-provider": "1.7.1",
		"@codemirror/autocomplete": "^6.20.1",
		"@codemirror/language": "^6.12.4",
		"@floating-ui/react": "^0.27.20",
		"@google-cloud/cloud-sql-connector": "^1.11.3",
		"@google-cloud/kms": "^6.0.0",
		"@google-cloud/storage": "^8.0.1",
		"@googlemaps/js-api-loader": "^2.1.1",
		"@iconify/react": "^6.0.2",
		"@lezer/common": "^1.5.1",
		"@lezer/highlight": "^1.2.3",
		"@lezer/lr": "^1.4.8",
		"@modelcontextprotocol/server": "^2.0.0",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-use-controllable-state": "^1.2.6",
		"@sentry/nextjs": "^10.70.0",
		"@tanstack/react-table": "^9.1.2",
		"@tanstack/react-virtual": "^3.14.10",
		"@tiptap/extension-image": "^3.30.3",
		"@tiptap/extension-list": "^3.30.3",
		"@tiptap/extension-mention": "^3.30.3",
		"@tiptap/extension-subscript": "^3.30.3",
		"@tiptap/extension-superscript": "^3.30.3",
		"@tiptap/extension-table": "^3.30.3",
		"@tiptap/extension-table-cell": "^3.30.3",
		"@tiptap/extension-table-header": "^3.30.3",
		"@tiptap/extension-table-row": "^3.30.3",
		"@tiptap/pm": "^3.30.3",
		"@tiptap/react": "^3.30.3",
		"@tiptap/starter-kit": "^3.30.3",
		"@tiptap/suggestion": "^3.27.3",
		"@types/google.maps": "^3.65.5",
		"@uiw/codemirror-themes": "^4.25.11",
		"@uiw/react-codemirror": "^4.25.11",
		"adm-zip": "^0.6.0",
		"ai": "7.0.79",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"better-auth": "1.7.1",
		"clsx": "^2.1.1",
		"commander": "^15.0.0",
		"date-fns": "^4.1.0",
		"dom-serializer": "^3.0.0",
		"domutils": "^4.0.0",
		"file-type": "^22.0.2",
		"fumadocs-core": "^16.15.1",
		"fumadocs-mdx": "^15.3.1",
		"fumadocs-ui": "^16.15.1",
		"fuse.js": "^7.5.0",
		"htmlparser2": "^12.0.0",
		"immer": "^11.1.18",
		"kysely": "^0.29.5",
		"lucide-react": "^1.33.0",
		"mammoth": "^1.12.1",
		"markdown-to-jsx": "^9.10.2",
		"motion": "^13.1.1",
		"music-metadata": "^11.15.0",
		"next": "16.3.3",
		"react": "19.2.8",
		"react-day-picker": "^10.0.0",
		"react-dom": "19.2.8",
		"react-hotkeys-hook": "^5.3.3",
		"server-only": "^0.0.1",
		"shadcn": "^4.19.0",
		"sharp": "^0.35.3",
		"tailwind-merge": "^3.6.0",
		"tiptap-markdown": "^0.9.0",
		"tw-animate-css": "^1.4.0",
		"undici": "^8.10.0",
		"uuid": "^14.0.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.3.6",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@base-ui/react": "^1.7.0",
		"@biomejs/biome": "2.5.10",
		"@iconify-icons/tabler": "^1.2.95",
		"@lezer/generator": "^1.8.0",
		"@modelcontextprotocol/client": "^2.0.0",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4",
		"@testcontainers/postgresql": "^12.1.0",
		"@testing-library/react": "^16.3.2",
		"@types/markdown-it": "^14.2.0",
		"@types/mdx": "^2.0.13",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"agent-react-devtools": "0.4.0",
		"class-variance-authority": "^0.7.1",
		"dotenv": "^17.3.1",
		"esbuild": "^0.28.2",
		"fast-check": "^4.9.0",
		"google-auth-library": "^11.0.2",
		"happy-dom": "^20.11.6",
		"lefthook": "^2.1.10",
		"pg": "^8.23.0",
		"react-devtools-core": "6.1.5",
		"tailwindcss": "^4",
		"tsx": "^4.23.12",
		"typescript": "7.0.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"@ai-sdk/workflow": {
			"ai": "$ai"
		},
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"postcss": "^8.5.12",
		"uuid": "^14.0.0",
		"sharp": "^0.35.3"
	}
}
